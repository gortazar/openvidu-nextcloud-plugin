{
	"name": "gortazar/openviduintegration",
	"description": "Nextcloud app: embed OpenVidu Meet video-conferencing rooms",
	"type": "nextcloud-app",
	"license": "AGPL-3.0-or-later",
	"authors": [
		{
			"name": "Gorka Eguileor",
			"email": "gortazar@gmail.com"
		}
	],
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"phpunit/phpunit": "^11"
	},
	"autoload": {
		"psr-4": {
			"OCA\\OpenViduIntegration\\": "lib/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"OCA\\OpenViduIntegration\\Tests\\": "tests/"
		}
	},
	"config": {
		"sort-packages": true
	}
}
