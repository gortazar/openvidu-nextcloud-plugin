{
	"name": "gortazar/openviduintegration",
	"description": "Nextcloud app: embed OpenVidu Meet video-conferencing rooms",
	"type": "nextcloud-app",
	"license": "Apache-2.0",
	"authors": [
		{
			"name": "Patxi Gortázar",
			"email": "francisco.gortazar@urjc.es"
		}
	],
	"require": {
		"php": ">=8.2"
	},
	"require-dev": {
		"phpunit/phpunit": "^11"
	},
	"autoload": {
		"psr-4": {
			"OCA\\OpenViduIntegration\\": "lib/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"OCA\\OpenViduIntegration\\Tests\\": "tests/"
		}
	},
	"config": {
		"sort-packages": true
	}
}
